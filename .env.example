DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Generate a unique password for the fictional template owner before seeding.
DEMO_PASSWORD=

# Optional delivery: disabled until your own provider and verified sender are configured.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_DELIVERY_MODE=preview
PASSWORD_RESET_FROM='Fold <onboarding@resend.dev>'
PASSWORD_RESET_PREVIEW_RECIPIENT=owner@example.invalid
RESEND_API_KEY=
PASSWORD_RESET_SENDER_VERIFIED=false

# Optional owner alerts. Use a sender on your verified Resend domain.
RESPONSE_ALERT_FROM=
RESPONSE_ALERT_SENDER_VERIFIED=false

# Optional Google Sheets. Use a dedicated service account with no delegation.
GOOGLE_SHEETS_SERVICE_EMAIL=
GOOGLE_SHEETS_SERVICE_KEY=
